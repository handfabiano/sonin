# ========================================
# SUPABASE
# ========================================
# Obtenha essas informações em: https://app.supabase.com/project/_/settings/api

NEXT_PUBLIC_SUPABASE_URL=your-project-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ========================================
# STRIPE
# ========================================
# Obtenha essas informações em: https://dashboard.stripe.com/test/apikeys

# Chave pública (começa com pk_test_ ou pk_live_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxx

# Chave secreta (começa com sk_test_ ou sk_live_) - NUNCA compartilhe!
STRIPE_SECRET_KEY=sk_test_xxxxx

# Webhook secret (opcional para desenvolvimento, obrigatório para produção)
# Obtenha em: https://dashboard.stripe.com/webhooks
STRIPE_WEBHOOK_SECRET=whsec_xxxxx
